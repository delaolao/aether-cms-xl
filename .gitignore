# Static site folder
_site

# Editor folders
.vscode/

# Cache folder
/content/cache/

# User data
/content/data/

# Ignore everything in content/themes
content/themes/*

# But do not ignore the default folder
!content/themes/default

# Built-in custom theme shipped with this repo (ember)
!content/themes/ember

# 本站新前端主题（2026-09-19）：杂志式布局 + 青玉配色。
# 主题属于代码（不是实例数据），必须入库 —— 否则只能靠同步脚本的文件清单部署，仓库里没有留档。
!content/themes/jade

# User uploads
/content/uploads/

# Node modules
node_modules

# Environment Variables
.env

# Local npm cache used by offline installs
/.npm-cache/

# Release snapshots (build artifacts)
/release/

# Local deployment tooling â€” contains private server address / instance paths,
# so it stays on the operator's machine. Share a parameterised copy instead.
/tools/sync-today-to-server.ps1

# 同步脚本的清单自检临时文件
/.aether-recent-files.tmp
